{
  "expo": {
    "name": "Architect",
    "slug": "architect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8e5de"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.architec.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Architect needs photo access to upload your Ghana Card and profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Architect needs your location to find nearby experts."
        }
      ]
    ]
  }
}
